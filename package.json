{
  "name": "fablearc",
  "version": "1.0.0",
  "private": true,
  "description": "FABLEARC — Security-Hardened Cloud & Desktop Cinema Streaming Platform with 4K Multi-Audio FFmpeg Pipeline & 3NF Turso Cloud Replica",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "tsc -b && vite build",
    "start": "vite preview --host 0.0.0.0",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "db:users": "node scripts/manage-users.mjs",
    "electron:dev": "ELECTRON_START_URL=http://localhost:5173 electron electron/main.cjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "hls.js": "^1.5.17",
    "lucide-react": "^0.468.0",
    "node-sqlite3-wasm": "^0.8.61",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
